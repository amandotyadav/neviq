{
  "name": "naviq-server",
  "version": "1.0.0",
  "description": "Naviq API — Your future, better navigated.",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node scripts/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "refresh": "node scripts/daily-refresh.js",
    "sources:check": "node scripts/check-sources.js",
    "test": "vitest run",
    "lint": "node --check src/server.js && node scripts/lint.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
